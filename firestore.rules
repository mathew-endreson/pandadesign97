rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in [
          'dakvKxwe96T1OGBI68mpyITXWc42',
          'mpZd2jY6LgbFrWtuMasJPXbjbca2'
        ];
    }

    // Public storefront reads the catalog with no auth; only admins add/edit/remove products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Checkout creates an order with no auth; only admins can view or manage the order list.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
